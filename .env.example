# Server only — never prefix with VITE_ (would expose to the browser)
FAL_KEY=your_fal_api_key_here

# Optional overrides
# FAL_STYLIZE_MODEL=fal-ai/flux/dev/image-to-image
# STYLIZE_PORT=8787

# Client: set to "local" to force canvas posterize fallback (no API)
# VITE_STYLIZE_MODE=local

# Optional personal, noncommercial game extracts; see public/assets/personal/CREDITS.md
# VITE_PERSONAL_ASSETS=false
